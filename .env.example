# NetCoreNOC configuration — copy to `.env` and edit. All values are OPTIONAL; with none set,
# NetCoreNOC runs with its zero-config defaults. `.env` is git-ignored: it is the only place
# secrets belong (never the image or docker-compose.yml). `docker compose` auto-loads `.env`.
#
#   cp .env.example .env
#   docker compose up --build

# --- Database (ADR #452) --------------------------------------------------------------------
# docker-compose.yml starts its own PostgreSQL and generates its password: leave these unset.
# For a managed PostgreSQL (Supabase, RDS, Cloud SQL...) use docker-compose.supabase.yml and set
# the connection string here WITHOUT the password; the password goes in secrets/db_password.txt.
#   Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (port 5432).
# NETCORENOC_DATABASE_URL=postgresql://postgres.<project-ref>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# The schema the tables live in (one appliance per schema).
# NETCORENOC_DB_SCHEMA=netcorenoc
# Connections the console's reads use, besides the one writer (1-64).
# NETCORENOC_DB_READERS=4
# Prepared statements cached per connection. 0 only behind a transaction-mode pooler.
# NETCORENOC_DB_STATEMENT_CACHE=1024

# Comma-separated source CIDRs allowed to send traps. Empty = accept all (zero-config default;
# NetCoreNOC shows a persistent admin banner until you set one). Set it to your equipment's CIDRs.
NETCORENOC_ALLOWLIST=

# Retention horizons (days).
NETCORENOC_RETENTION_DAYS=7
NETCORENOC_AUDIT_RETENTION_DAYS=365

# Structured JSON logging: set to 1 to enable. Empty/0/false = human-readable logs.
NETCORENOC_LOG_JSON=

# --- Built-in TLS (recommended for any non-loopback exposure) ---------------------------------
# Paths INSIDE the container. Mount your cert/key read-only via docker-compose.yml (see the
# commented TLS profile there), then point these at the mount. The session cookie gains the
# Secure flag automatically when both are set. Leave empty to serve plain HTTP (a TLS reverse
# proxy is the documented alternative — see docs/security.md). Setting only ONE of the two is a
# hard startup error naming the other: TLS needs both.
NETCORENOC_TLS_CERT=
NETCORENOC_TLS_KEY=

# A repeated alarm that was silent longer than this (seconds) is a NEW occurrence and opens a new
# situation, as when its clear was lost. 0 = a repeat always stays in its situation.
NETCORENOC_REARM_S=3600

# --- Outgoing email (password recovery) ------------------------------------------------------
# Configure the SMTP server in the console: Settings -> Email. Set this only to keep the SMTP
# password out of the database (and its backups); when set it is used and the field is ignored.
# NETCORENOC_SMTP_PASSWORD=

# --- High trap port (avoid binding privileged UDP 162) ----------------------------------------
# Uncomment to listen on 1162: docker-compose.yml maps the same port and passes it to the process.
# Point your devices' trap destination at <host>:1162. CAP_NET_BIND_SERVICE is then unnecessary.
# NETCORENOC_TRAP_PORT=1162

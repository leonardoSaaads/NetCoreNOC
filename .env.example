# NetCoreNOC configuration — copy to `.env` and edit. All values are OPTIONAL; with none set,
# NetCoreNOC runs with its zero-config defaults. `.env` is git-ignored: it is the only place
# secrets belong (never the image or docker-compose.yml). `docker compose` auto-loads `.env`.
#
#   cp .env.example .env
#   docker compose up --build

# Comma-separated source CIDRs allowed to send traps. Empty = accept all (zero-config default;
# NetCoreNOC shows a persistent admin banner until you set one). Set it to your equipment's CIDRs.
NETCORENOC_ALLOWLIST=

# Retention horizons (days).
NETCORENOC_RETENTION_DAYS=7
NETCORENOC_AUDIT_RETENTION_DAYS=365

# Structured JSON logging: set to 1 to enable. Empty/0/false = human-readable logs.
NETCORENOC_LOG_JSON=

# --- Built-in TLS (recommended for any non-loopback exposure) ---------------------------------
# Paths INSIDE the container. Mount your cert/key read-only via docker-compose.yml (see the
# commented TLS profile there), then point these at the mount. The session cookie gains the
# Secure flag automatically when both are set. Leave empty to serve plain HTTP (a TLS reverse
# proxy is the documented alternative — see docs/security.md). Setting only ONE of the two is a
# hard startup error naming the other: TLS needs both.
NETCORENOC_TLS_CERT=
NETCORENOC_TLS_KEY=

# --- High trap port (avoid binding privileged UDP 162) ----------------------------------------
# If you map a high host port instead of 162 (and drop CAP_NET_BIND_SERVICE in the compose file),
# set the port here and in the compose `ports:` mapping.
# NETCORENOC_TRAP_PORT=1162
